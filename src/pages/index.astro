---
import '../styles/global.css';

const name = "Yuanyuan Wu";
const tagline = "I study how language shapes society, and I use code to prove it.";
const email = "florencewu103@gmail.com";
const github = "https://github.com/wu-wu33";

const education = [
  {
    degree: "M.A. in Linguistics (Computational Linguistics)",
    school: "National University of Defense Technology",
    years: "2024 – 2027",
    details: "GPA: 3.5/4.0",
    courses: "Functional Linguistics, Corpus Linguistics, Natural Language Processing, Machine Learning, Big Data Fundamentals, Advanced Data Mining, Simulation Engineering Practice"
  },
  {
    degree: "B.A. in English",
    school: "Nanchang Institute of Technology",
    years: "2015 – 2019",
    details: "GPA: 3.2/4.0",
    courses: ""
  }
];

const published = [
  {
    authors: "Wu, Y. & Jiao, X.",
    year: "2025",
    title: "An FCE Corpus-Based Analysis of Writing Errors in Chinese English Learners: Common Types, Patterns, and Pedagogical Implications",
    venue: "Journal of English Language Teaching and Linguistics, 10(1), 141–152",
    link: "http://dx.doi.org/10.21462/jeltl.v10i1.1527",
    abstract: "Using the Cambridge Learner Corpus, this study identifies the most frequent writing error patterns among Chinese English learners through corpus-based statistical analysis. It finds that L1 negative transfer strongly affects tense, subject-verb agreement, articles, and prepositions, and proposes four pedagogical strategies for writing instruction."
  },
  {
    authors: "Wu, Y. & Xiao, R.",
    year: "2025",
    title: "Discursive Construction of Military Identity on the Imperial War Museum Website: A Hybrid Topic Modeling and Multimodal Perspective",
    venue: "Proceedings of the 11th Brno Conference on Linguistics Studies in English (BCLSE 2025), Brno, Czech Republic",
    link: "",
    abstract: "This study combines LDA topic modeling with multimodal discourse analysis to examine how the Imperial War Museum website constructs military identity. It identifies four primary themes and four discursive strategies that reframe military identity as socially embedded and technically authoritative."
  }
];

const workingPapers = [
  {
    authors: "Wu, Y. & Jiao, X.",
    year: "2025",
    title: "A Discourse Analysis of Public Comments on Donald Trump's Two Victory Speeches",
    venue: "Working paper",
    abstract: "Analyzing 45,000+ YouTube comments on Trump's 2016 and 2024 victory speeches, this study combines sentiment analysis, semantic co-occurrence networks, and LDA topic modeling with systemic functional linguistics. It finds a significant shift from neutral to positive sentiment, and from immigration to economic security as the dominant topic."
  },
  {
    authors: "Wu, Y. & Jiao, X.",
    year: "2025",
    title: "Sentiment and Topic Analysis of Overseas Social Media Comments on China's Zhuhai Airshow",
    venue: "Working paper",
    abstract: "Using sentiment analysis, LDA topic modeling, and BERTopic on 11,447 English YouTube comments, this study examines how overseas audiences perceive China's emerging military technologies. It finds a neutral-to-positive sentiment tendency and identifies five major discussion topics."
  },
  {
    authors: "Wu, Y. & Jiao, X.",
    year: "2025",
    title: "Esports Match Prediction via a Player-Centric Feature Framework",
    venue: "Working paper",
    abstract: "This paper proposes a player-centric framework for pre-match outcome prediction in Honor of Kings. Five interpretable capability dimensions are constructed from historical match data, and LightGBM achieves 75% accuracy. Feature importance varies systematically across positions."
  }
];

const projects = [
  {
    title: "\"What Do Female Players Say?\": Cross-Cultural Analysis of Language and Cultural Differences in Game Comments",
    description: "Compared 17,000+ Bilibili and YouTube comments on the game Love and Deepspace using LDA topic modeling and part-of-speech analysis. Showed that Chinese comments rely on high-context emotional density, while English comments favor low-context, label-like expressions.",
    tech: ["Python", "LDA", "POS Analysis", "jieba", "spaCy"]
  },
  {
    title: "Housing Prices Prediction — Kaggle Competition",
    description: "Ranked 103 out of 4,331 teams. Built a stacking ensemble model with extensive feature engineering, achieving a 4.4% improvement over the best single model. Explored linear, tree-based, and gradient boosting models, with Ridge as the meta-learner.",
    tech: ["Python", "XGBoost", "LightGBM", "Stacking Ensemble", "Feature Engineering"]
  },
  {
    title: "Hate Speech Detection with Semi-Supervised Learning",
    description: "Compared pseudo-labeling and self-training on 5,000 sampled tweets across three annotation ratios. Introduced 14 discourse-analytic features (lexical, syntactic, affective, structural) that improved accuracy by 9.8% over TF-IDF alone. Conducted error analysis showing 77.3% of errors are false positives.",
    tech: ["Python", "scikit-learn", "Semi-Supervised Learning", "Feature Engineering", "ANOVA"]
  },
  {
    title: "Graph-Based Character Network Analysis of <em>Dream of the Red Chamber</em>",
    description: "Constructed a weighted character relationship network from a classical Chinese novel. Applied centrality analysis, Louvain community detection, and Node2Vec embeddings to reveal structural roles and distinguish between broad-shallow and narrow-deep relationship types.",
    tech: ["Python", "NetworkX", "Node2Vec", "Louvain", "Graph Analysis"]
  }
];

const skills = {
  "Languages": ["Python", "R", "Stata", "SQL"],
  "Methods": [
    "Natural Language Processing",
    "Machine Learning (Supervised & Semi-Supervised)",
    "Feature Engineering",
    "Graph Mining & Network Analysis",
    "Statistical Modeling & Hypothesis Testing",
    "Text Mining & Topic Modeling"
  ],
  "ML & NLP Tools": ["scikit-learn", "LightGBM", "XGBoost", "spaCy", "NLTK", "Gensim", "NetworkX"],
  "Human Languages": ["Chinese (Native)", "English (IELTS 7.0, TEM-8, CATTI L3)", "Japanese (JLPT N3)", "French (Basic)"]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name}</title>
  <meta name="description" content={tagline} />
</head>
<body>

  <header class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>{name}</h1>
        <p class="tagline">{tagline}</p>
        <div class="links">
          <a href={`mailto:${email}`}>{email}</a>
          <a href={github} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/wuyuanyuan.github.io/photo.jpg" alt={name} />
      </div>
    </div>
  </header>

  <main class="container">

    <section id="about">
      <h2>About</h2>
      <p>
        I am a graduate student in Linguistics at National University of Defense Technology, 
        expecting to graduate in 2027. My work sits at the intersection of linguistics, 
        natural language processing, and data science — turning unstructured text into 
        insight with Python, statistics, and curiosity.
      </p>
      <p>
        I have published on corpus-based error analysis and multimodal discourse, and I am 
        currently working on several projects involving sentiment analysis, topic modeling, 
        and predictive modeling on social media and esports data.
      </p>
    </section>

    <section id="education">
      <h2>Education</h2>
      <ul class="edu-list">
        {education.map(edu => (
          <li class="edu-item">
            <div class="edu-degree">{edu.degree}</div>
            <div class="edu-school">{edu.school} · {edu.years}</div>
            {edu.details && <div class="edu-details">{edu.details}</div>}
            {edu.courses && <div class="edu-courses">Relevant coursework: {edu.courses}</div>}
          </li>
        ))}
      </ul>
    </section>

    <section id="publications">
      <h2>Publications</h2>
      <ul class="pub-list">
        {published.map(pub => (
          <li class="pub-item">
            <div class="pub-title">
              {pub.link ? <a href={pub.link} target="_blank" rel="noopener">{pub.title}</a> : pub.title}
            </div>
            <div class="pub-meta">
              {pub.authors} ({pub.year}). <em>{pub.venue}</em>.
            </div>
            <p class="pub-abstract">{pub.abstract}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="working-papers">
      <h2>Working Papers</h2>
      <ul class="pub-list">
        {workingPapers.map(pub => (
          <li class="pub-item">
            <div class="pub-title">{pub.title}</div>
            <div class="pub-meta">
              {pub.authors} ({pub.year}). <em>{pub.venue}</em>.
            </div>
            <p class="pub-abstract">{pub.abstract}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="projects">
      <h2>Course Projects</h2>
      <div class="project-grid">
        {projects.map(proj => (
          <div class="project-card">
            <h3 set:html={proj.title} />
            <p>{proj.description}</p>
            <div class="tags">
              {proj.tech.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="experience">
      <h2>Work Experience</h2>
      <ul class="exp-list">
        <li>
          <span class="exp-role">Senior Consultant</span>, 
          Ningbo Yinzhou Chengde Enterprise Management Co., Ltd.
          <span class="exp-year">2019–2023</span>
        </li>
        <li>
          <span class="exp-role">Foreign Trade Salesperson</span>, 
          Jiangxi Yixi Electric Co., Ltd.
          <span class="exp-year">2024</span>
        </li>
      </ul>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <div class="skills-grid">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skill-group">
            <h3>{category}</h3>
            <ul>
              {items.map(item => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

  </main>

  <footer>
    <div class="container">
      <p>© {new Date().getFullYear()} {name}. Built with Astro.</p>
    </div>
  </footer>

</body>
</html>